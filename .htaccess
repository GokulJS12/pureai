# ─────────────────────────────────────────────────────────────────────
#  Pure AI — Apache / LiteSpeed / cPanel clean-URL config
#  Enables extensionless URLs like /innovation, /sol-banking, /trading-desk
# ─────────────────────────────────────────────────────────────────────

Options -MultiViews +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Canonicalize: 301 redirect any legacy *.html URL to its clean form.
    #    /innovation.html        -> /innovation
    #    /sol-banking.html#hero  -> /sol-banking#hero  (fragment preserved by browser)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 2) If the requested path has no extension and the corresponding .html
    #    file exists on disk, rewrite (internal) to serve it silently.
    #    /innovation  ->  /innovation.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ─────────────────────────────────────────────────────────────────────
#  Security & performance polish
# ─────────────────────────────────────────────────────────────────────

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

ErrorDocument 404 /index.html
