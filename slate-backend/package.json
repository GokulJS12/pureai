{
  "name": "slate-backend",
  "version": "1.0.0",
  "description": "SLATE — calm lifestyle OS backend (Phase 1, rule-based, no external APIs)",
  "type": "module",
  "main": "electron/main.cjs",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch src/server.ts\" \"node scripts/serve-frontend.mjs\"",
    "dev:api": "tsx watch src/server.ts",
    "serve:frontend": "node scripts/serve-frontend.mjs",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "app": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
